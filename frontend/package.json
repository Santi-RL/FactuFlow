{
  "name": "factuflow-frontend",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --max-warnings 0",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --max-warnings 0",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --max-warnings 0",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "npm run test:coverage:gate && vitest run --coverage",
    "test:coverage:gate": "node --test scripts/coverage-gate.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "test:e2e:ui": "node ./scripts/run-e2e.mjs --ui"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "pinia": "^2.1.7",
    "vue": "^3.5.42",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@heroicons/vue": "^2.1.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "@vue/test-utils": {
      "js-beautify": "2.0.3"
    }
  }
}
